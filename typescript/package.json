{
  "name": "@openbindings/openapi-client",
  "version": "0.1.0",
  "description": "Deterministic document-driven client for Swagger 2.0 and OpenAPI 3.0, 3.1, and 3.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "verify:browser": "node scripts/verify-browser-bundle.mjs"
  },
  "keywords": [
    "openapi",
    "swagger",
    "client",
    "typescript",
    "javascript",
    "http"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openbindings/openapi-client.git",
    "directory": "typescript"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "js-yaml": "^4.2.0",
    "json-schema-library": "^11.6.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "esbuild": "0.27.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  }
}
